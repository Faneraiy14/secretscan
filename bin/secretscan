#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../src/Finding.php';
require __DIR__ . '/../src/SecretScanner.php';

use SecretScan\SecretScanner;

function colorize(string $text, string $color): string
{
    $codes = ['red' => '31', 'green' => '32', 'yellow' => '33', 'cyan' => '36', 'gray' => '90'];
    if (!isset($codes[$color])) {
        return $text;
    }
    return "\033[{$codes[$color]}m{$text}\033[0m";
}

function printUsage(): void
{
    echo "secretscan — шукає випадково закомічені секрети (API-ключі,\n";
    echo "токени, приватні ключі) у файлах проєкту.\n\n";
    echo "Використання:\n";
    echo "  secretscan [шлях] [опції]\n\n";
    echo "За замовчуванням: поточна папка. .git/node_modules/vendor не скануються.\n\n";
    echo "Опції:\n";
    echo "  --json    вивід як JSON замість тексту з кольорами — для CI\n";
    echo "            та інших скриптів, а не для читання людиною\n";
}

$args = array_slice($argv, 1);

if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
    printUsage();
    exit(0);
}

$json = in_array('--json', $args, true);
$positional = array_values(array_filter($args, static fn (string $a): bool => $a !== '--json'));
$path = $positional[0] ?? '.';

$scanner = new SecretScanner();

try {
    $findings = $scanner->scan($path);
} catch (\RuntimeException $e) {
    if ($json) {
        echo json_encode(['error' => $e->getMessage()], JSON_UNESCAPED_UNICODE) . "\n";
    } else {
        fwrite(STDERR, colorize('Помилка: ', 'red') . $e->getMessage() . "\n");
    }
    exit(2);
}

if ($json) {
    echo json_encode([
        'ok' => $findings === [],
        'path' => $path,
        'findings' => array_map(static fn ($f) => [
            'file' => $f->file,
            'line' => $f->line,
            'rule' => $f->rule,
            'redacted' => $f->redacted,
        ], $findings),
    ], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT) . "\n";
    exit($findings === [] ? 0 : 1);
}

if ($findings === []) {
    echo colorize('✓ ', 'green') . "Секретів не знайдено в {$path}\n";
    exit(0);
}

echo colorize('✗ Знайдено ' . count($findings) . ' підозрілих значень', 'red') . ":\n\n";
foreach ($findings as $finding) {
    echo colorize($finding->rule, 'yellow') . "\n";
    echo "    {$finding->file}:{$finding->line}\n";
    echo '    ' . colorize($finding->redacted, 'gray') . "\n\n";
}
echo "Якщо це справжній секрет — забери його з коду, перевипусти токен/ключ,\n";
echo "додай файл у .gitignore. Якщо це заглушка/приклад — перейменуй так,\n";
echo "щоб містила 'example'/'placeholder'/'changeme' тощо (секретскан це пропускає).\n";

exit(1);
