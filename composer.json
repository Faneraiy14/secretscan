{
    "name": "faneraiy14/secretscan",
    "description": "CLI-утиліта, що шукає випадково закомічені секрети (API-ключі, токени, приватні ключі) у файлах проєкту.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Faneraiy14"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "SecretScan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/secretscan"
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10"
    },
    "scripts": {
        "test": "phpunit"
    }
}
